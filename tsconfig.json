{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "tests/**/*"],
  // PR-26: the browser specs are TypeScript for a *browser*, not for this
  // Node-only lib set — their `page.evaluate` callbacks reference `document` and
  // `getComputedStyle`. Excluding them here rather than adding "dom" to `lib`
  // keeps the server code unable to reach for a DOM that does not exist at
  // runtime, and `tests/browser/tsconfig.json` typechecks them under the gate
  // (`pnpm run typecheck` runs both projects).
  "exclude": ["node_modules", "dist", "archive", "tests/browser", "src/web/client"]
}

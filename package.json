{
  "name": "vmng",
  "version": "1.0.0",
  "description": "Virtual Media Network Limited (VMNL) Enterprise & Creative Economy Ecosystem",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "main": "dist/src/index.js",
  "scripts": {
    "start": "node dist/src/index.js",
    "cli": "node dist/src/cli/index.js",
    "db:seed": "node dist/src/db/migrate-and-seed.js",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "audit:check": "node scripts/audit-check.js",
    "audit:threshold": "node scripts/audit-threshold.js",
    "any:budget": "node scripts/explicit-any-budget.js",
    "test:a11y": "playwright test"
  },
  "keywords": [
    "vmnl",
    "broadcast",
    "creative-economy",
    "azeebo",
    "enterprise"
  ],
  "author": "Virtual Media Network Limited",
  "license": "UNLICENSED",
  "pnpm": {
    "overrides": {
      "lodash": "4.18.1",
      "deepmerge-ts": "8.0.2",
      "mysql2": "3.24.5",
      "source-map-js": "^1.2.2"
    }
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10.11.0",
    "prisma": "7.10.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}

{
  "name": "vmnworld",
  "version": "1.0.0",
  "description": "VMN World — Virtual Media Network Limited (VMNL) Enterprise & Creative Economy Ecosystem",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "main": "dist/src/index.js",
  "scripts": {
    "start": "node dist/src/index.js",
    "cli": "node dist/src/cli/index.js",
    "db:seed": "node dist/src/db/migrate-and-seed.js",
    "build": "tsc && vite build",
    "build:client": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/browser && tsc --noEmit -p src/web/client",
    "lint": "eslint . --max-warnings 0",
    "audit:check": "node scripts/audit-check.js",
    "audit:threshold": "node scripts/audit-threshold.js",
    "any:budget": "node scripts/explicit-any-budget.js",
    "ia:generate": "node scripts/ia/generate-ia-registry.mjs && node scripts/ia/generate-ia-registry.mjs --check",
    "test:a11y": "vitest run tests/a11y",
    "test:browser": "playwright test"
  },
  "keywords": [
    "vmnl",
    "broadcast",
    "creative-economy",
    "azeebo",
    "enterprise"
  ],
  "author": "Virtual Media Network Limited",
  "license": "UNLICENSED",
  "pnpm": {
    "overrides": {
      "lodash": "4.18.1",
      "deepmerge-ts": "8.0.2",
      "mysql2": "3.24.5",
      "source-map-js": "^1.2.2",
      "effect": "3.22.5",
      "fast-uri": "3.1.9"
    }
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "4.1.11",
    "effect": "^3.22.5",
    "eslint": "^10.11.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.8",
    "vitest": "^4.1.11"
  }
}

# VMNL Enterprise Configuration Environment Template
# Authority: VMNL-AZP-VMN-CCPP-001 §6, §11, §19, §21
# NEVER commit sensitive production credentials or live API keys to version control.

# Node Environment
NODE_ENV=development
PORT=5500
APP_NAME="VMNL Enterprise Orchestrator"
APP_URL=http://localhost:5500

# Sandbox PostgreSQL connection (Compose app uses the postgres service hostname).
# For host-run development, replace postgres with localhost and use the same sandbox identity.
DATABASE_URL=postgresql://vmn_user:${POSTGRES_PASSWORD:-vmn_sandbox_only_password}@postgres:5432/vmn_enterprise?schema=public
# TSK-61: the test suite never runs against DATABASE_URL. Vitest derives a dedicated
# `<dbname>_test` database from it (created and `prisma migrate deploy`ed automatically
# by tests/global-setup.ts), so `pnpm test` is deterministic whether or not the
# development database above is seeded. Uncomment to override the derived target.
# TEST_DATABASE_URL=postgresql://vmn_user:${POSTGRES_PASSWORD:-vmn_sandbox_only_password}@localhost:5432/vmn_enterprise_test?schema=public
# POSTGRES_PASSWORD is a local sandbox secret; never reuse it outside this stack.
POSTGRES_PASSWORD=vmn_sandbox_only_password
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# Redis / BullMQ Message Bus
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & Security
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_SECRET_KEY_HERE
JWT_EXPIRATION_SECONDS=86400
SESSION_COOKIE_NAME=vmnl_session
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,https://vmnl.ng,https://azeebo.plus
FUSION_EVENTS_HMAC_SECRET=fusion_events_hmac_secret_key_32chars_min
# Dedicated CSRF session secret — MUST differ from JWT_SECRET (AUD-08). Required in production.
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_MIN_32_CHARS_HERE
# Field-level PII encryption key — required in production/staging (AUD-09). Min 32 chars.
PII_ENCRYPTION_KEY=CHANGE_ME_PII_ENCRYPTION_KEY_MIN_32_CHARS

# Reverse proxy contract (AUD-03). Only set TRUST_PROXY_HEADERS=true when the
# app runs behind a trusted reverse proxy; TRUSTED_PROXY_HOPS is the number of
# trusted proxy hops to strip from the right of X-Forwarded-For.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_HOPS=1

# Readiness gating (AUD-09). Set false only for deployments without DAM storage.
STORAGE_READINESS_GATING=true

# Dev Seed Credentials & Production Users Store (T-05)
# In development/test, DEV_SEED_PASSWORD supplies the fallback password for local sandbox accounts.
DEV_SEED_PASSWORD=vmnl-dev-seed-pass-2026#secure
# In production/staging, seed accounts MUST be passed via VMNL_SEED_USERS_JSON containing pre-hashed bcrypt strings.
# Example: '[{"id":"usr-001","email":"admin@vmnl.ng","passwordHash":"$2a$12$...","role":"ExecutiveSuperAdmin"}]'
VMNL_SEED_USERS_JSON=

# Payment Gateway Webhooks & Ingestion (T-01, T-02, T-03)
# Live secret keys provided via payment gateway dashboards; required for HMAC-SHA512 verification.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
# Sandbox bypass strictly for isolated dev unit testing without gateway secrets (defaults to false)
WEBHOOK_SIGNATURE_BYPASS_ALLOWED=false

# Unified Notification Services (T-14)
# Termii SMS gateway credentials for Nigerian mobile destination delivery (E.164 without plus)
TERMII_API_KEY=
TERMII_SENDER_ID=VMNL
# SMTP transactional email service (or AWS SES SMTP interface)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
AWS_REGION=eu-west-1

# Development Mode Overrides & Sandboxes
AUTH_BYPASS_ENABLED=false
# AUD-10: fail-closed is the default and the safe choice. Memory fallback
# serves unverified sandbox data when the database is unavailable and must
# never be enabled in production or staging (boot refuses it there).
ALLOW_SANDBOX_FALLBACK=false

# Object Storage (S3 / MinIO)
STORAGE_DRIVER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=vmnl-assets
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1

# Azeebo+ Federation Contracts
AZEEBO_PLUS_UNIVERSAL_URL=https://azeebo.plus
AZEEBO_API_BASE_URL=https://api.azeebo.plus/v1
AZEEBO_CLIENT_ID=vmnl_enterprise_hub
AZEEBO_WEBHOOK_SECRET=azeebo_hmac_webhook_secret_key_32chars
# Inbound Azeebo+ event ingestion stays disabled until the partner signature
# contract is verified (AUD-02). Enable only with documented partner approval.
AZEEBO_WEBHOOK_INGESTION_ENABLED=false

# Observability & Telemetry (T-21)
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# PostgreSQL Backup Automation (TODO-PRC-08)
# Nightly snapshot backup via the vmnl-postgres-backup compose service.
# AUD-22: compose Redis refuses to boot without this (requirepass mandatory;
# healthcheck authenticates). Sandbox default below is explicitly
# non-production — set a real value per deployment.
REDIS_PASSWORD=vmn_sandbox_only_redis_password
# TODO-SEC-10: distributed KV adapter backend. Unset/empty → in-memory
# fallback (sandbox, zero infra, CACHE_BACKEND=memory telemetry). Compose
# stacks: redis://:${REDIS_PASSWORD}@redis:6379
REDIS_URL=
# AUD-03/AUD-04: production/staging boots refuse the in-memory KV backend
# (sessions, lockouts, MFA challenges and rate limits would be per-instance
# and lost on restart). Set REDIS_URL in production; only a deliberate
# single-instance deployment may flip this explicit escape hatch.
ALLOW_MEMORY_KV_IN_PRODUCTION=false

# TODO-PRC-08: postgres-backup service retention (days) for pg_dump+WAL
# archives (docker/backups/backup.sh prunes beyond this).
VMNL_BACKUP_RETENTION_DAYS=14
PROMETHEUS_METRICS_ENABLED=true
